# ──────────────────────────────────────
# Root .gitignore for Agentic AI Platform
# ──────────────────────────────────────

# Environment files (contain secrets)
.env
.env.*
!.env.example

# ─── Backend (Java / Spring Boot) ───
agentic-ai-platform/target/
agentic-ai-platform/.mvn/wrapper/maven-wrapper.jar
agentic-ai-platform/postgres-data/

# IDE files
.idea/
*.iws
*.iml
*.ipr
.vscode/
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ─── Frontend (Node.js / React) ───
ai-agentic-frontend/node_modules/
ai-agentic-frontend/dist/
ai-agentic-frontend/dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini
